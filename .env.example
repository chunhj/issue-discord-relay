# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Secret configured on the GitHub webhook (Settings > Webhooks > Secret).
GITHUB_WEBHOOK_SECRET=change-me

# Discord channel webhook URL. Placeholder only; real URLs contain a secret token.
DISCORD_WEBHOOK_URL=https://discord.example.invalid/api/webhooks/<id>/<token>

# Local Postgres from docker-compose.yml. Default dev credentials, local use only.
# DB_URL is for host runs such as bootRun only; compose gives the app container its own address (postgres:5432).
DB_URL=jdbc:postgresql://localhost:5432/webhook
DB_USERNAME=webhook
DB_PASSWORD=webhook

# Do not use a dollar sign ($) in any value: compose reads $name as a variable and cuts the value short.

# Optional: host port for the app (default 80).
# HTTP_PORT=8081

# Optional: host port for Postgres, bound to 127.0.0.1 only (default 5432).
# DB_HOST_PORT=15432
