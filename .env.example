# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Secret configured on the GitHub webhook (Settings > Webhooks > Secret).
GITHUB_WEBHOOK_SECRET=change-me

# Discord channel webhook URL. Placeholder only; real URLs contain a secret token.
DISCORD_WEBHOOK_URL=https://discord.example.invalid/api/webhooks/<id>/<token>

# Local Postgres from docker-compose.yml. Default dev credentials, local use only.
DB_URL=jdbc:postgresql://localhost:5432/webhook
DB_USERNAME=webhook
DB_PASSWORD=webhook
